{
  "name": "career-jobs",
  "version": "0.1.0",
  "private": true,
  "description": "Apify actor: search a daily index of open roles on 5,000+ company career sites (Workday, Greenhouse, Ashby, Lever).",
  "type": "module",
  "engines": { "node": ">=22" },
  "scripts": {
    "start": "node --experimental-strip-types src/main.ts",
    "local": "CRAWLEE_STORAGE_DIR=./storage ACTOR_TEST_PAY_PER_EVENT=1 node --experimental-strip-types src/main.ts",
    "test": "node --experimental-strip-types --test test/*.test.ts",
    "crawl": "node --experimental-strip-types crawler/crawl.ts",
    "publish-index": "node --experimental-strip-types crawler/publish.ts"
  },
  "dependencies": {
    "apify": "^3.7.2"
  }
}
