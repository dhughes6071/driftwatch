<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<!-- Daily 09:00 index health check (notifies if the nightly run failed or the index is stale). Install: cp to ~/Library/LaunchAgents/ and launchctl load it. -->
<plist version="1.0">
<dict>
  <key>Label</key><string>com.x402.career-jobs-check</string>
  <key>ProgramArguments</key>
  <array><string>/bin/zsh</string><string>/Users/chaz-michaelmichaels/X402/actors/career-jobs/crawler/check-index.sh</string></array>
  <key>EnvironmentVariables</key>
  <dict><key>PATH</key><string>/opt/homebrew/bin:/usr/local/bin:/usr/bin:/bin</string></dict>
  <key>StartCalendarInterval</key>
  <dict><key>Hour</key><integer>9</integer><key>Minute</key><integer>0</integer></dict>
  <key>StandardOutPath</key><string>/tmp/career-jobs-check.launchd.log</string>
  <key>StandardErrorPath</key><string>/tmp/career-jobs-check.launchd.log</string>
</dict>
</plist>
