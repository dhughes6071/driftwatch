{
  "name": "healthcare-jobs",
  "version": "0.1.0",
  "private": true,
  "description": "Apify actor: open jobs at the largest US health systems, with clinical tags, from a daily index of company career sites.",
  "type": "module",
  "engines": { "node": ">=22" },
  "scripts": {
    "start": "node --experimental-strip-types src/main.ts",
    "local": "CRAWLEE_STORAGE_DIR=./storage ACTOR_TEST_PAY_PER_EVENT=1 node --experimental-strip-types src/main.ts",
    "test": "node --experimental-strip-types --test test/*.test.ts"
  },
  "dependencies": {
    "apify": "^3.7.2"
  }
}
