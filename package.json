{
  "name": "driftwatch",
  "version": "0.1.0",
  "private": true,
  "description": "Dependency migration intelligence for AI coding agents. Answers: library went A -> B, what broke and what edits does my code need?",
  "type": "module",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "dev": "START_SERVER=1 node --experimental-strip-types --watch src/api/server.ts",
    "start": "START_SERVER=1 node --experimental-strip-types src/api/server.ts",
    "mcp": "node --experimental-strip-types src/mcp/server.ts",
    "test": "node --experimental-strip-types --test test/*.test.ts",
    "ingest": "node --experimental-strip-types scripts/ingest.ts",
    "testclient": "node --experimental-strip-types scripts/test-agent.ts",
    "wallet:new": "node --experimental-strip-types scripts/new-testnet-wallet.ts",
    "jobs:smoke": "node --experimental-strip-types scripts/jobs-smoke-test.ts",
    "jobs:coverage": "node --experimental-strip-types scripts/jobs-coverage-test.ts",
    "jobs:discover": "node --experimental-strip-types scripts/refresh-companies.ts",
    "actor:local": "CRAWLEE_STORAGE_DIR=./.actor-storage ACTOR_TEST_PAY_PER_EVENT=1 node --experimental-strip-types src/jobs/main.ts",
    "jobs:export": "node --experimental-strip-types scripts/export-companies.ts"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^0.121.0",
    "@modelcontextprotocol/sdk": "^1.30.0",
    "@x402/core": "^2.23.0",
    "@x402/evm": "^2.23.0",
    "@x402/express": "^2.23.0",
    "@x402/extensions": "^2.23.0",
    "@x402/fetch": "^2.23.0",
    "apify": "^3.7.2",
    "better-sqlite3": "^13.0.3",
    "dotenv": "^17.4.2",
    "express": "^5.2.1",
    "viem": "^2.56.0",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@types/better-sqlite3": "^9.6.0",
    "@types/express": "^5.0.6",
    "@types/node": "^26.3.0",
    "typescript": "^7.0.2"
  }
}
