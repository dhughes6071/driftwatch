# ============================================================================
# driftwatch configuration
#
# Copy to .env and edit:   cp .env.example .env
# NEVER commit .env. It is gitignored.
# ============================================================================

NODE_ENV=development
PORT=4021
LOG_LEVEL=info

# Public URL of this service. Used in the OpenAPI spec and llms.txt so agents
# can find you. Set this to your real domain once deployed.
PUBLIC_URL=http://localhost:4021

# Where the SQLite file lives. Back this up -- it is your cache and your ledger.
DB_PATH=./data/driftwatch.db


# ---------------------------------------------------------------- payments
# Start with x402 OFF. Turn it on only when you are ready to test payments.
X402_ENABLED=false

# base-sepolia = TESTNET (play money, free, safe)
# base         = MAINNET (REAL money -- requires I_UNDERSTAND_THIS_IS_REAL_MONEY=yes)
X402_NETWORK=base-sepolia

# Your RECEIVING address. This is public information, not a secret.
# The private key for it must NEVER be on this server. See docs/SECURITY.md.
X402_PAY_TO=

# List on the x402 Bazaar so agents can discover the service. Free.
X402_DISCOVERABLE=true

# Price per call. Fixed pricing -- simple to reason about, simple to explain.
PRICE_DELTA=$0.05
PRICE_MANIFEST=$0.15


# ---------------------------------------------------------------- LLM (optional, COSTS MONEY)
# OFF by default. With it off the service still works and returns cited
# deterministic results. Turning it on improves answer quality.
# Read docs/COSTS.md before enabling.
LLM_ENABLED=false
ANTHROPIC_API_KEY=
LLM_MODEL=claude-opus-5

# HARD daily spend ceiling in USD. When reached, the service silently falls
# back to the free deterministic tier rather than spending more.
LLM_MAX_DAILY_SPEND_USD=1.00
LLM_MAX_OUTPUT_TOKENS=4000


# ---------------------------------------------------------------- limits
FREE_RATE_PER_HOUR=60
HARD_RATE_PER_HOUR=600
MAX_MANIFEST_PACKAGES=50
UPSTREAM_TIMEOUT_MS=10000


# ---------------------------------------------------------------- safety
# Flip to true and restart to make every paid endpoint return 503.
EMERGENCY_SHUTDOWN=false

# Salt for hashing client IPs before storing them. Change it; any value works.
CLIENT_HASH_SALT=change-me-to-anything-random


# ---------------------------------------------------------------- optional
# Raises GitHub's rate limit from 60/hr to 5000/hr. Free. Read-only scope only.
GITHUB_TOKEN=

# TESTNET wallet for the test agent. Generated by `npm run wallet:new`.
# TESTNET ONLY -- never put a mainnet key here.
TESTNET_PRIVATE_KEY=
